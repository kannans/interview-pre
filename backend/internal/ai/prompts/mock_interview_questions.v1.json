{
  "version": "v1",
  "id": "mock_interview_questions",
  "schema_name": "mock_interview_questions",
  "model": "gpt-4o-mini",
  "temperature": 0.5,
  "max_output_tokens": 2048,
  "system_instruction": "STUB — Reserved for Phase 8 mock interview module. Will generate a mixed mock interview question set (coding, conceptual, behavioral) tailored to profile and focus areas. Not wired to an API endpoint yet.",
  "user_input_shape": {
    "profile": { "experience_years": "integer", "target_role": "string", "target_companies": "string" },
    "focus_areas": ["string"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "category": { "type": "string" },
            "level": { "type": "string" },
            "title": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["type", "category", "level", "title", "content"],
          "additionalProperties": false
        }
      }
    },
    "required": ["questions"],
    "additionalProperties": false
  },
  "example_input": {
    "profile": { "experience_years": 6, "target_role": "Senior SWE", "target_companies": "Amazon", "weak_areas_self": "DSA", "timeline": "45 days" },
    "focus_areas": ["trees", "leadership stories"]
  },
  "example_output": {
    "questions": [
      { "type": "dsa", "category": "trees", "level": "level_2", "title": "Lowest common ancestor", "content": "Given a binary tree, find LCA of two nodes." }
    ]
  }
}
