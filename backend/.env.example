# Server Configuration
PORT=8080
ENV=development

# Database Connection
# Format: postgres://username:password@host:port/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/interview_prep?sslmode=disable

# Optional: path to SQL migrations (default: auto-discover db/migrations from repo root)
# MIGRATIONS_PATH=../db/migrations

# OpenAI Integration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
