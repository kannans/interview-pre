# Copy to .env at repo root for docker compose (never commit .env)

# Required for AI endpoints (diagnosis, plan, evaluate, progress snapshot)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Frontend talks to API — baked into the Next.js image at build time
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# API CORS — comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Containerized Postgres (used by docker compose postgres + api DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_prep

# Optional host port overrides
# POSTGRES_PORT=5432
# API_PORT=8080
# FRONTEND_PORT=3000

# Optional runtime label
# ENV=production
